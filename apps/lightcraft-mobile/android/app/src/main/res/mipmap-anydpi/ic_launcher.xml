<?xml version="1.0" encoding="utf-8"?>
<!-- LightCraft's own icon (assets/app-icon/lightcraft-1024.png, copied in by the build as
     drawable/ic_launcher_tile): the rounded tile inset to the 72 dp a launcher shows, on its amber. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_tile"
            android:inset="18dp" />
    </foreground>
</adaptive-icon>
